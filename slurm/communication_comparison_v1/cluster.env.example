# Copy and fill observed values. Literal KEY=value syntax, with shell-style quotes
# for spaces. No variable expansion, command substitution or executable shell.
SOURCE_ROOT=/absolute/read-only/source-snapshot
RUN_ROOT=/absolute/study-root
BOOTSTRAP_PYTHON=/absolute/python3.11
PCP_PYTHON=/absolute/new-communication-v1-pcp/bin/python
MAPDN_PYTHON=/absolute/new-communication-v1-mapdn/bin/python
WHEELHOUSE=/absolute/staged-linux-wheelhouse
REQUIREMENTS_LOCK=/absolute/linux-requirements-with-hashes.txt
ACCOUNT=REPLACE_WITH_ACCOUNT
PARTITION=REPLACE_WITH_PARTITION
MODULES="-"
DEVICE=cpu
GPU_COUNT=0
# Resource requests below are placeholders, NOT measured forecasts. Adjust after
# probe/smoke/qualification without changing the one-thread numerical contract.
CPUS=2
MEMORY=8G
PCP_TIME=2-00:00:00
MAPDN_TIME=2-00:00:00
CONTROL_TIME=04:00:00
PCP_CONCURRENCY=2
MAPDN_CONCURRENCY=2
MIN_FREE_GIB=20
