.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/

# BenchMARL run folders (created in the cwd where train.py is launched)
/*_simple_spread_*/
outputs/

# Managed experiment artifacts. Keep suite definitions and analysis code in
# Git; raw checkpoints/logs and regenerated result products stay local.
/runs/
/results/

# Scheduler stdout/stderr. The sbatch scripts themselves are tracked.
/slurm/logs/
# Machine-specific module/venv names resolved by 01_setup.sbatch.
/slurm/.resolved_env

# BenchMARL writes a generated run directory next to the working directory when
# an Experiment is built without an explicit save_folder. The test suite does
# that repeatedly, so these land in the repo root and are easy to `git add` by
# accident. They are scratch, never evidence -- real run output goes to runs/.
mappo_*_ensemblemodel__*/
*_ensemblemodel__*/
